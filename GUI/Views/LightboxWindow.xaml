<Window x:Class="BFGDL.NET.Views.LightboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Grid>
        <!-- Full-screen backdrop — click any dark area to close -->
        <Rectangle x:Name="Backdrop" Fill="#D9000000" MouseDown="Backdrop_MouseDown" />

        <!-- Main image — fills available area between arrow margins -->
        <Image x:Name="MainImage"
               Stretch="Uniform"
               Margin="100,60,100,80"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Left arrow -->
        <Button x:Name="PrevButton"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="16,0"
                Width="56" Height="56"
                Style="{StaticResource NavArrowButton}"
                Click="PrevButton_Click"
                ToolTip="Previous (←)">
            <Path Data="M 10,0 L 0,12 L 10,24"
                  Stroke="White" StrokeThickness="3"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <!-- Right arrow -->
        <Button x:Name="NextButton"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="16,0"
                Width="56" Height="56"
                Style="{StaticResource NavArrowButton}"
                Click="NextButton_Click"
                ToolTip="Next (→)">
            <Path Data="M 0,0 L 10,12 L 0,24"
                  Stroke="White" StrokeThickness="3"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <!-- Close button -->
        <Button HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="16"
                Width="44" Height="44"
                Style="{StaticResource NavArrowButton}"
                Click="CloseButton_Click"
                ToolTip="Close (Esc)">
            <Path Data="M 2,2 L 14,14 M 14,2 L 2,14"
                  Stroke="White" StrokeThickness="2.5"
                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>

        <!-- Counter "2 / 5" -->
        <TextBlock x:Name="CounterText"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,20"
                   Foreground="White"
                   FontSize="14"
                   FontFamily="Segoe UI"
                   Opacity="0.6" />
    </Grid>
</Window>
