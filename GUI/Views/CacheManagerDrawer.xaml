<UserControl x:Class="BFGDL.NET.Views.CacheManagerDrawer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:BFGDL.NET.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="260" d:DesignWidth="1200">

    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,10,16,12">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header row: title, concurrency, close -->
                <RowDefinition Height="Auto" />
                <!-- Language selector row -->
                <RowDefinition Height="Auto" />
                <!-- Progress rows -->
                <RowDefinition Height="*" />
                <!-- Footer: status + buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ── Header ── -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Cache Manager"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />

                <!-- Concurrency slider -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Parallelism "
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <Slider Width="120"
                            Minimum="1" Maximum="16" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding ConcurrencyLevel}"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InvertedBoolConverter}}" />
                    <TextBlock Text="{Binding ConcurrencyLevel}"
                               Width="24" TextAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Select All / None -->
                <Button Grid.Column="4" Content="All"
                        Command="{Binding SelectAllCommand}"
                        Padding="10,3" FontSize="12"
                        Background="{StaticResource SurfaceHighBrush}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertedBoolConverter}}" />

                <Button Grid.Column="6" Content="None"
                        Command="{Binding SelectNoneCommand}"
                        Padding="10,3" FontSize="12"
                        Background="{StaticResource SurfaceHighBrush}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>

            <!-- ── Language selector ── -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding AvailableLanguages}"
                          Margin="0,0,0,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      IsEnabled="{Binding DataContext.IsRunning,
                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                    Converter={StaticResource InvertedBoolConverter}}" />
                            <TextBlock Text="{Binding Language}"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ── Progress rows ── -->
            <ScrollViewer Grid.Row="2"
                          MaxHeight="100"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0,0,0,8">
                <ItemsControl ItemsSource="{Binding LanguageStatuses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LanguageFetchStatus}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>

                                <!-- Language name + active indicator -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                             VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                                        <Setter Property="Fill" Value="#FF4CAF50" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Language}"
                                               FontSize="12"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Page progress bar -->
                                <ProgressBar Grid.Column="1"
                                             Minimum="0"
                                             Maximum="{Binding TotalPages}"
                                             Value="{Binding Page}"
                                             Height="6"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />

                                <!-- Game stats text -->
                                <TextBlock Grid.Column="2"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Page " /><Run Text="{Binding Page}" />
                                    <Run Text="/" /><Run Text="{Binding TotalPages}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding GamesNew}" Foreground="{StaticResource AccentBrush}" />
                                    <Run Text=" new  " />
                                    <Run Text="{Binding GamesSkipped}" />
                                    <Run Text=" skip  " />
                                    <Run Text="{Binding GamesFailed}" />
                                    <Run Text=" fail  " />
                                    <Run Text="{Binding ImagesNew}" Foreground="{StaticResource AccentBrush}" />
                                    <Run Text=" imgs" />
                                </TextBlock>

                                <!-- Done badge -->
                                <TextBlock Grid.Column="3"
                                           Text="✓ Done"
                                           FontSize="11"
                                           Foreground="#FF4CAF50"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ── Footer ── -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="▶  Start"
                        Command="{Binding StartCommand}"
                        Padding="16,5"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        FontWeight="SemiBold" />

                <Button Grid.Column="2"
                        Content="■  Cancel"
                        Command="{Binding CancelCommand}"
                        Padding="16,5"
                        Background="{StaticResource SurfaceHighBrush}" />

                <TextBlock Grid.Column="3"
                           Text="{Binding StatusText}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
